---
import { Font } from "astro:assets";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import stats from "../data/stats.json";

const SITE_NAME = "Roots of Tomorrow";
const DEFAULT_DESCRIPTION =
  "A youth-led 501(c)(3) nonprofit restoring native forests across Northeast Ohio.";

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  seamlessFooter = false,
  // Utility pages (the form's thank-you page, the 404) should not be indexed.
  // A noindex page gets no canonical: the two are contradictory signals.
  noindex = false,
  // Page-specific structured data (an FAQPage, an AboutPage). The NGO and
  // WebSite nodes below stay on the home page only, because site-wide
  // Organization markup is noise to Google. A node that describes *this* page
  // is a different thing, so a page may pass its own and it renders here.
  jsonLd = null,
} = Astro.props;

// Absolute URLs for link previews. Scrapers ignore relative og: values.
const ogImage = new URL("/images/og-card.jpg", Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
const isHome = Astro.url.pathname === "/";

// The share card shows the tree count, so the alt repeats it. The number comes
// from stats.json like every other number on the site.
const ogImageAlt = `${SITE_NAME}: ${stats.treesPlanted}+ trees planted. Planting native trees and restoring forests.`;

// Structured data, home page only. Google does not need site-wide markup, and
// every value below is backed by something visible on the site: the name and
// logo in the nav and footer, the email and social links in the footer, the
// 501(c)(3) status on the home and donate pages, the counties on the home page,
// and the chapter cities on the chapter map (home and chapter pages).
//
// The EIN belongs to the Hack Foundation, which fiscally sponsors us (the
// footer says exactly that), so it is modelled as the sponsor's taxID and not
// as ours.
const organizationId = `${siteUrl}#organization`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NGO",
      "@id": organizationId,
      name: SITE_NAME,
      url: siteUrl,
      logo: new URL("/rootslogo.png", Astro.site).href,
      image: ogImage,
      description: DEFAULT_DESCRIPTION,
      email: stats.email,
      sameAs: [stats.instagram, stats.linkedin],
      nonprofitStatus: "https://schema.org/Nonprofit501c3",
      foundingDate: stats.founded,
      foundingLocation: { "@type": "Place", name: stats.region },
      // No street address is published anywhere on the site, so the region is
      // as specific as this can honestly get. A made-up address would be worse
      // than none: it is the kind of detail a grant reviewer checks.
      address: {
        "@type": "PostalAddress",
        addressRegion: stats.state,
        addressCountry: "US",
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "General enquiries",
        email: stats.email,
        areaServed: "US",
        availableLanguage: "English",
      },
      sponsor: {
        "@type": "Organization",
        name: "The Hack Foundation",
        taxID: stats.ein,
      },
      areaServed: [
        ...stats.counties.map((county) => ({
          "@type": "AdministrativeArea",
          name: `${county} County, Ohio`,
        })),
        ...stats.chapters.map((chapter) => ({
          "@type": "City",
          name: `${chapter.city}, ${chapter.state}`,
        })),
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: SITE_NAME,
      url: siteUrl,
      inLanguage: "en-US",
      publisher: { "@id": organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#1f3d2b" />

    <!-- Self-hosted woff2, emitted from the fonts block in astro.config.mjs.
         Each Font component writes its own font-face rules plus a preload
         link, so the files start downloading with the HTML instead of being
         discovered only after a third-party stylesheet is fetched and parsed. -->
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-franklin" preload />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Runs during parse so the reveal styles only hide content when JS is on. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-canopy focus:px-4 focus:py-2 focus:text-paper">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer seamless={seamlessFooter} />

    <!-- Reveal-on-scroll for [data-reveal] and count-up for [data-count]. -->
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const reveals = document.querySelectorAll("[data-reveal]");
      if (reveals.length) {
        if (!reduce && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: "0px 0px -8% 0px" }
          );
          reveals.forEach((el) => io.observe(el));
        } else {
          reveals.forEach((el) => el.classList.add("is-revealed"));
        }
      }

      // Numbers like "10,000", "240 Tons", or "1,000+" count up from zero the
      // first time they scroll into view. The rendered value is the fallback.
      const counts = document.querySelectorAll<HTMLElement>("[data-count]");
      if (counts.length && !reduce && "IntersectionObserver" in window) {
        const animate = (el: HTMLElement) => {
          const match = (el.dataset.count || "").match(/^([\d,]+)(.*)$/);
          if (!match) return;
          const target = parseInt(match[1].replace(/,/g, ""), 10);
          const suffix = match[2];
          const duration = 1400;
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = Math.round(target * eased).toLocaleString("en-US") + suffix;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animate(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );
        counts.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
