---
// Two presentations of the same past-event photos:
//  - Mobile: a simple swipe / click-through slideshow (the marquee transform
//    animation was unreliable on phones, so we avoid it there entirely).
//  - Desktop: an auto-scrolling, infinitely looping marquee. The list is
//    duplicated once so the track can translate by exactly -50% for a seamless
//    CSS-only loop.
// Captions turn the photo wall into evidence: date, place, what went in the
// ground. Keep them short: "Apr 2025 · Burton Township · 700 seedlings".
// A photo with an empty caption renders exactly as before, so fill these in
// as you match photos to events.
// width/height are the files' real pixel dimensions. They let the browser
// reserve the right box before the photo arrives, which keeps the section
// from shifting as it loads.
//
// `alt` describes what is in the photo, for screen readers and for Google
// Images. It is never shown on screen. `caption` is the visible label; filling
// one in makes the caption appear over the photo, so leave it empty until you
// have the real date, place, and count for that day.
const photos = [
  { src: "/images/events/event1.jpg", alt: "A student digging a planting hole with a spade in a grassy field", width: 1000, height: 869, caption: "" },
  { src: "/images/events/event2.jpg", alt: "Volunteers in rain gear spread along a line of orange marker flags at the edge of the woods", width: 1000, height: 749, caption: "" },
  { src: "/images/events/event3.jpg", alt: "Three students standing on a fallen log in a field staked out for planting", width: 1000, height: 750, caption: "" },
  { src: "/images/events/event4.jpg", alt: "An orange marker flag along the tree line of a green field on a rainy spring day", width: 1000, height: 823, caption: "" },
  { src: "/images/events/event5.jpg", alt: "Students and adult volunteers standing with shovels on freshly turned ground", width: 1000, height: 926, caption: "" },
  { src: "/images/events/event6.jpg", alt: "Students and volunteers with muddy shovels and boots at the end of a rainy planting day", width: 1000, height: 629, caption: "" },
  { src: "/images/events/event7.jpg", alt: "A student breaking ground with a spade in a bare field in front of a winter treeline", width: 1000, height: 750, caption: "" },
];
const track = [...photos, ...photos];
---

<section class="mx-auto max-w-6xl px-6 pt-24" data-reveal>
  <p class="text-sm font-600 uppercase tracking-[0.2em] text-moss">Past Events</p>
  <h2 class="mt-3 font-display text-3xl font-600 leading-tight text-canopy sm:text-4xl">
    Where we've put down roots.
  </h2>

  <!-- Mobile: swipe or tap the arrows to move through the photos. -->
  <div class="relative mt-8 sm:hidden">
    <div id="event-slides" class="slides flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-2xl">
      {photos.map((p) => (
        <figure class="relative w-full shrink-0 snap-start overflow-hidden ring-1 ring-canopy/10">
          <img
            src={p.src}
            alt={p.alt}
            width={p.width}
            height={p.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          {p.caption && (
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-canopy/85 to-transparent px-4 pb-3 pt-10 text-xs font-500 text-paper">
              {p.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
    <button
      type="button"
      data-slide-prev
      aria-label="Previous photo"
      class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-canopy/80 text-lg text-paper shadow-md backdrop-blur-sm transition-colors hover:bg-canopy"
    >&larr;</button>
    <button
      type="button"
      data-slide-next
      aria-label="Next photo"
      class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-canopy/80 text-lg text-paper shadow-md backdrop-blur-sm transition-colors hover:bg-canopy"
    >&rarr;</button>
  </div>

  <!-- Desktop: auto-scrolling, infinitely looping marquee. -->
  <div class="carousel tilt-3d mt-8 hidden overflow-hidden sm:block" data-tilt="7">
    <div class="track flex w-max">
      {track.map((p, i) => (
        <figure
          aria-hidden={i >= photos.length ? "true" : undefined}
          class="relative mr-6 h-80 w-80 flex-none overflow-hidden rounded-2xl shadow-md ring-1 ring-canopy/10 transition-all duration-500 ease-out hover:scale-[1.03] hover:shadow-xl"
        >
          <img
            src={p.src}
            alt={i < photos.length ? p.alt : ""}
            width={p.width}
            height={p.height}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          {p.caption && (
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-canopy/85 to-transparent px-4 pb-3 pt-10 text-xs font-500 text-paper">
              {p.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const slides = document.getElementById("event-slides");
  if (slides) {
    document.querySelector("[data-slide-prev]")?.addEventListener("click", () => {
      slides.scrollBy({ left: -slides.clientWidth, behavior: "smooth" });
    });
    document.querySelector("[data-slide-next]")?.addEventListener("click", () => {
      slides.scrollBy({ left: slides.clientWidth, behavior: "smooth" });
    });
  }
</script>

<style>
  /* Hide the scrollbar on the mobile slideshow (swipe/arrows drive it). */
  .slides {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }

  /* Soft fade at both edges of the desktop marquee. */
  .carousel {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    animation: event-scroll 38s linear infinite;
    will-change: transform;
  }
  /* Pause when a visitor hovers so they can look at a photo. */
  .carousel:hover .track {
    animation-play-state: paused;
  }
  @keyframes event-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* Respect users who ask for reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
