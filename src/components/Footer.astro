---
import stats from "../data/stats.json";
import { Image } from "astro:assets";
import logo from "../assets/rootslogo-128.png";

const { seamless = false } = Astro.props;
---

<footer class:list={["bg-canopy text-paper", { "mt-24": !seamless }]}>
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 font-display text-xl font-600">
          <Image src={logo} alt="Roots of Tomorrow logo" width={36} height={36} widths={[36, 72]} sizes="36px" loading="lazy" decoding="async" class="rounded-full" />
          Roots of Tomorrow
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-sprout">
          A youth-led nonprofit restoring native forests across Northeast Ohio.
        </p>
      </div>

      <div>
        <p class="text-xs font-600 uppercase tracking-wider text-moss">Explore</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/get-involved/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Get Involved</a></li>
          <li><a href="/chapter/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Start a Chapter</a></li>
          <li><a href="/guides/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Guides</a></li>
          <li><a href="/faq/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Questions and answers</a></li>
          <li><a href="/contact/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Contact</a></li>
          <li><a href="/donate/" class="inline-block text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">Donate</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-600 uppercase tracking-wider text-moss">Reach Us</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href={`mailto:${stats.email}`} class="group inline-flex items-center gap-2.5 text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">
              <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-sprout group-hover:text-paper" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              {stats.email}
            </a>
          </li>
          <li>
            <a href={stats.instagram} rel="me" class="group inline-flex items-center gap-2.5 text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">
              <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-sprout group-hover:text-paper" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
              </svg>
              {stats.instagramHandle}
            </a>
          </li>
          <li>
            <a href={stats.linkedin} rel="me" aria-label="Roots of Tomorrow on LinkedIn" class="group inline-flex items-center gap-2.5 text-paper/80 transition-transform duration-200 hover:translate-x-0.5 hover:text-paper">
              <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-sprout group-hover:text-paper" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3v-11zm6.5 0h3.8v1.5h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4v-11z" />
              </svg>
              Roots of Tomorrow
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-leaf/40 pt-6 text-xs text-sprout">
      <p>Roots of Tomorrow is fiscally sponsored by the Hack Foundation. EIN: {stats.ein}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>© {new Date().getFullYear()} Roots of Tomorrow. All rights reserved.</span>
        <a href="/legal/privacy-policy/" class="hover:text-paper">Privacy Policy</a>
        <a href="/legal/terms-of-service/" class="hover:text-paper">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
