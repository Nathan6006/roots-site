---
import Layout from "../layouts/Layout.astro";
import StatBlock from "../components/StatBlock.astro";
import EventCarousel from "../components/EventCarousel.astro";
import CtaBand from "../components/CtaBand.astro";
import stats from "../data/stats.json";

const counties = stats.counties.join(", ").replace(/, ([^,]*)$/, ", and $1");
---

<Layout
  title="Youth-led native tree planting in Northeast Ohio | Roots of Tomorrow"
  description={`Student-led 501(c)(3) planting native trees across ${counties} counties in Northeast Ohio. ${stats.treesPlanted} in the ground so far.`}
>
  <!-- Hero -->
  <section class="relative flex h-[67vh] items-center overflow-hidden">
    <!-- Parallax background -->
    <img
      id="hero-bg"
      src="/images/homeHero.jpg"
      alt="Hands settling a young native seedling into dark soil"
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="sync"
      class="absolute inset-x-0 -bottom-24 -top-24 h-[calc(100%+12rem)] w-full object-cover"
      style="will-change: transform;"
    />
    <!-- Dark gradient overlay -->
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-canopy/70 via-canopy/60 to-canopy/80"></div>
    <!-- Soft fade into the page below -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24" style="background: linear-gradient(to bottom, rgba(251,250,245,0) 0%, rgba(251,250,245,0.02) 45%, rgba(251,250,245,0.08) 65%, rgba(251,250,245,0.2) 80%, rgba(251,250,245,0.45) 90%, rgba(251,250,245,0.75) 96%, rgba(251,250,245,1) 100%);"></div>
    <!-- Content -->
    <div class="rise-in relative mx-auto w-full max-w-6xl px-8 pb-16 pt-24">
      <p class="mb-5 text-xs font-600 uppercase tracking-[0.3em] text-sprout">Welcome to</p>
      <h1 class="max-w-4xl font-display text-5xl font-600 leading-[1.04] text-paper drop-shadow-lg sm:text-7xl md:text-8xl">
        Roots of<br />Tomorrow
      </h1>
      <p class="mt-7 max-w-xl text-xl leading-relaxed text-paper/80">
        A youth-led nonprofit planting native trees and restoring forests
        across Northeast Ohio, built by the students who'll inherit them.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/get-involved/" class="rounded-full bg-paper px-8 py-3.5 text-base font-600 text-canopy shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-sprout hover:shadow-lg">
          Get Involved
        </a>
        <a href="/donate/" class="rounded-full border border-paper/60 px-8 py-3.5 text-base font-600 text-paper backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-paper/15">
          Donate
        </a>
      </div>
    </div>
  </section>

  <script>
    const bg = document.getElementById('hero-bg');
    if (bg) {
      window.addEventListener('scroll', () => {
        bg.style.transform = `translateY(${window.scrollY * 0.4}px)`;
      }, { passive: true });
    }
  </script>

  <!-- Scroll-linked 3D tilt for the content images (not the hero). -->
  <script>
    const tilts = document.querySelectorAll<HTMLElement>('.tilt-3d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (tilts.length && !reduce) {
      let ticking = false;
      const update = () => {
        const mid = window.innerHeight / 2;
        tilts.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.height === 0) return; // skip hidden (e.g. desktop carousel on mobile)
          const max = parseFloat(el.dataset.tilt || '16'); // degrees
          let p = (r.top + r.height / 2 - mid) / mid; // -1 above .. +1 below center
          p = Math.max(-1, Math.min(1, p));
          el.style.transform = `perspective(900px) rotateX(${(-p * max).toFixed(2)}deg)`;
        });
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }
  </script>

  <!-- Stats -->
  <section class="mx-auto max-w-6xl mt-8 px-6" data-reveal>
    <StatBlock />
  </section>

  <!-- Who stands behind the work. The relationship labels are deliberate:
       "partnership" only where it's a real partnership, "guidance" for ODNR. -->
  <section class="mx-auto mt-14 max-w-6xl px-6" data-reveal>
    <div class="flex flex-col items-center gap-10 text-center sm:flex-row sm:flex-wrap sm:items-start sm:justify-center sm:gap-x-12 sm:gap-y-8">
      <div>
        <p class="text-[11px] font-600 uppercase tracking-[0.2em] text-moss">In partnership with</p>
        <p class="mt-2 font-display text-xl font-600 text-canopy">Holden Forests &amp; Gardens</p>
      </div>
      <div>
        <p class="text-[11px] font-600 uppercase tracking-[0.2em] text-moss">With guidance from</p>
        <p class="mt-2 font-display text-xl font-600 text-canopy">ODNR Service Foresters</p>
      </div>
      <div>
        <p class="text-[11px] font-600 uppercase tracking-[0.2em] text-moss">Fiscally sponsored by</p>
        <p class="mt-2 font-display text-xl font-600 text-canopy">The Hack Foundation</p>
      </div>
      <div>
        <p class="text-[11px] font-600 uppercase tracking-[0.2em] text-moss">Covered by</p>
        <a
          href="https://www.geaugamapleleaf.com/news/roots-of-tomorrow-takes-burton-farm-back-to-nature/"
          target="_blank"
          rel="noopener"
          class="mt-2 inline-block font-display text-xl font-600 text-canopy underline decoration-sprout decoration-2 underline-offset-4 transition-colors hover:text-leaf"
        >Geauga County Maple Leaf&thinsp;&nearr;</a>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="mt-16 bg-cream/60 px-6 py-16 sm:py-20" data-reveal>
    <div class="mx-auto max-w-3xl text-center">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mx-auto h-8 w-8 text-moss"
        aria-hidden="true"
      >
        <path d="M4 20C4 10 10 4 20 4c0 10-6 16-16 16Z" />
        <path d="M4 20c4-6 8-10 14-14" />
      </svg>
      <p class="mt-6 font-display text-2xl font-500 leading-snug text-canopy sm:text-[2rem]">
        We're a <span class="text-leaf underline decoration-sprout/70 decoration-2 underline-offset-[6px]">501(c)(3) student-led nonprofit</span> based in
        Northeast Ohio. We plant native trees to bring forests, clean air, and
        healthy habitat back to {counties} counties, while giving our
        generation a real way to shape the place we live.
      </p>
    </div>
  </section>

  <!-- Story: the why, made specific -->
  <section class="mx-auto mt-24 max-w-6xl px-6">
    <div class="grid items-center gap-12 md:grid-cols-2" data-reveal>
      <div class="tilt-3d overflow-hidden rounded-3xl shadow-xl ring-1 ring-canopy/10">
        <img src="/images/homeImage1.jpg" alt="A cleared woodlot left as bare stumps and fallen branches, with standing trees behind it" width="1050" height="825" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out hover:scale-105" />
      </div>
      <div>
        <p class="text-sm font-600 uppercase tracking-[0.2em] text-moss">Why we plant</p>
        <h2 class="mt-3 font-display text-3xl font-600 leading-tight text-canopy sm:text-4xl">
          The forests near home are thinning out.
        </h2>
        <p class="mt-5 leading-relaxed text-soil/75">
          Across our corner of Ohio, woodlots are being cleared, fields sit bare,
          and the native trees that once held the soil and cooled the summers are
          disappearing faster than they're coming back. The wildlife that depends
          on them goes with them.
        </p>
        <p class="mt-4 leading-relaxed text-soil/75">
          It's a problem you can stand in, and one you can fix with your hands.
          That's what drew us in.
        </p>
      </div>
    </div>

    <div class="mt-20 grid items-center gap-12 md:grid-cols-2" data-reveal>
      <div class="md:order-2">
        <p class="text-sm font-600 uppercase tracking-[0.2em] text-moss">What we do</p>
        <h2 class="mt-3 font-display text-3xl font-600 leading-tight text-canopy sm:text-4xl">
          Native trees, in the ground, by students.
        </h2>
        <p class="mt-5 leading-relaxed text-soil/75">
          We work directly with local landowners to turn unused acres into young
          native forests. That means matching the right species to the land,
          planting them, and looking after them as they take hold. Every project is run by
          students, with guidance from professional foresters.
        </p>
        <p class="mt-4 leading-relaxed text-soil/75">
          The result is land that does more for everyone: cleaner air, cooler
          ground, returning wildlife, and a generation that knows it can change
          something real.
        </p>
      </div>
      <div class="tilt-3d overflow-hidden rounded-3xl shadow-xl ring-1 ring-canopy/10 md:order-1">
        <img src="/images/homeImage2.jpg" alt="Two students marking planting spots with flags in an open field at the edge of the woods" width="1152" height="863" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out hover:scale-105" />
      </div>
    </div>
  </section>

  <!-- Past Events. (When the Planting Log comes back, restore the
       "Read the full planting log" link here; see src/pages/log.astro.) -->
  <EventCarousel />

  <!-- What the landowners say. VERBATIM ONLY inside quotation marks: these are
       exact sentences from landowners' recommendation letters and the Maple
       Leaf article. Trim with an ellipsis if you must; never reword quoted
       text, and never use a quote that names a student inside the quote. -->
  <section class="mx-auto mt-24 max-w-6xl px-6" data-reveal>
    <div class="max-w-2xl">
      <p class="text-sm font-600 uppercase tracking-[0.2em] text-moss">From the landowners</p>
      <h2 class="mt-3 font-display text-3xl font-600 leading-tight text-canopy sm:text-4xl">
        In their words.
      </h2>
    </div>

    <figure class="relative mt-10 overflow-hidden rounded-3xl bg-cream/70 px-8 pb-12 pt-16 ring-1 ring-canopy/10 sm:px-14 sm:pt-20">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute left-6 top-4 font-display text-7xl font-600 leading-none text-sprout/60 sm:left-8 sm:text-9xl"
      >&ldquo;</span>
      <blockquote class="relative font-display text-2xl font-500 leading-snug text-canopy sm:text-3xl">
        Out of the 2,110 trees and shrubs they planted, 2,093 survived. This is
        remarkable due to the poor summer weather conditions and the fact that
        they did the job correctly.
      </blockquote>
      <figcaption class="mt-8 text-xs font-600 uppercase tracking-[0.18em] text-moss">
        Chris Rea &amp; Dr. Renee Lambert &middot; Chestnut Ridge Farm, Burton Township
      </figcaption>
    </figure>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <figure class="flex flex-col justify-between rounded-3xl border border-canopy/10 bg-paper p-7 shadow-sm">
        <blockquote class="font-display text-lg font-500 leading-snug text-canopy">
          &ldquo;When these kids showed up, I thought, &lsquo;Oh no!&rsquo; But
          the forester worked with them before. Once they get going, they
          go!&rdquo;
        </blockquote>
        <figcaption class="mt-5 text-xs font-600 uppercase tracking-[0.18em] text-moss">
          Chris Rea
          <span class="mt-1 block">
            <a
              href="https://www.geaugamapleleaf.com/news/roots-of-tomorrow-takes-burton-farm-back-to-nature/"
              target="_blank"
              rel="noopener"
              class="font-body font-600 normal-case tracking-normal text-leaf underline decoration-sprout decoration-2 underline-offset-4 hover:text-canopy"
            >In the Geauga County Maple Leaf&thinsp;&nearr;</a>
          </span>
        </figcaption>
      </figure>

      <figure class="flex flex-col justify-between rounded-3xl border border-canopy/10 bg-paper p-7 shadow-sm">
        <blockquote class="font-display text-lg font-500 leading-snug text-canopy">
          &ldquo;I reached out and, without hesitation, the needed volunteers
          were mobilized to help us keep our planting on track.&rdquo;
        </blockquote>
        <figcaption class="mt-5 text-xs font-600 uppercase tracking-[0.18em] text-moss">
          Jennifer Villwock
          <span class="mt-1 block text-soil/50">Happy Suns Farm, Vermillion</span>
        </figcaption>
      </figure>

    </div>
  </section>

  <!-- Closing invitation -->
  <CtaBand />

</Layout>
